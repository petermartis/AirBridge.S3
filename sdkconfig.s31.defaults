# AirBridge.S3 — sdkconfig defaults for the ESP32-S31 port
# Used by PlatformIO ESP-IDF hybrid build (pioarduino, env:esp32s31)
#
# Mirrors sdkconfig.defaults (ESP32-S3-GEEK). Differences from that file
# are called out below; everything else applies for the same reasons.

# --- Arduino-as-component ---
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000

# --- IPv4 routing / NAT (NAPT) ---
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# --- TCP buffer/window + AMPDU block-ack window tuning for NAT throughput ---
# lwIP's own defaults here (5760-byte TCP window/send buffer, BA window
# 6) throttle throughput on real hardware (~7-11Mbit/s measured against
# a 1Gbit/s upstream). Raising both was tried and abandoned earlier in
# this project's history after a 100%-reproducible crash (every boot
# reaching exactly "wifi_ap_init OK" and dying before "wifi_sta_start
# OK") -- but that crash was later root-caused, independently, via
# esp_reset_reason() logged over serial, to a BROWNOUT reset: a current
# spike as the AP radio's PA ramps up to transmit its first beacon,
# tripping the chip's brownout detector on a marginal USB power supply.
# It reproduced identically at every TCP window value tried (65535,
# 16384, and fully reverted to stock 5760) and with the BA window at
# both 6 and 12 -- conclusive that neither of these values was ever the
# actual cause. They were reverted over a false correlation.
#
# Re-raising both now that a proper power supply (5V/5A, not a laptop's
# USB port) is confirmed to boot cleanly through the same point
# repeatedly with no BROWNOUT in the log. TX/RX_BA_WIN=12 and
# TCPIP_RECVMBOX_SIZE=64 match ESP-IDF's own documented throughput
# recommendations ("For iperf test in shieldbox, the recommended value
# is 9~12" for BA window). If a real crash reappears, check
# esp_reset_reason() in the log FIRST, before assuming it's one of
# these values again -- BROWNOUT was caught and mistaken for a software
# bug once already in this project.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=48
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ESP_WIFI_TX_BA_WIN=12
CONFIG_ESP_WIFI_RX_BA_WIN=12

# --- TinyUSB ECM networking (ECM preferred over NCM for macOS compatibility) ---
CONFIG_TINYUSB_NET_MODE_ECM_RNDIS=y

# --- Use custom PID to avoid macOS driver cache from NCM device ---
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4002

# --- DMA mode: needed for interrupt EP notification delivery ---
CONFIG_TINYUSB_MODE_DMA=y
# CONFIG_TINYUSB_MODE_SLAVE is not set

# CPU frequency: left unset, board default (320 MHz per boards/esp32-s31-
# coreboard-1.json) applies. Unlike the S3, S31's max Kconfig choice isn't
# confirmed to include 240 MHz, so we don't force the S3's value here.

# --- FreeRTOS runtime stats (for CPU utilization monitoring) ---
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# --- Disable HTTPS server (we only use HTTP) ---
CONFIG_ESP_HTTPS_SERVER_ENABLE=n

# --- USB OTG mode for TinyUSB (no serial console — use LCD for debug) ---
CONFIG_ARDUINO_USB_CDC_ON_BOOT=0
CONFIG_ARDUINO_USB_MODE=0

# --- Disable USB-Serial/JTAG console ---
# Tested on real S31 hardware: enabling
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y produced no second
# serial device and no change in what's visible over
# /dev/cu.usbmodem1101 -- the "dedicated PHY/port independent of USB
# OTG" documentation does not hold up in practice on this board, at
# least not without further changes this wasn't worth chasing further.
# Back to no secondary console; use the LCD for debug instead (see
# display_debug_step()).
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Flash size ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
